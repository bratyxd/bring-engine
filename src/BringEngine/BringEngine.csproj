<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>BringEngine</RootNamespace>
    <AssemblyName>BringEngine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.20" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
  </ItemGroup>

  <!-- Cross-platform SDL3 & Shadercross native runtimes -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-arm64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.20" />
    <PackageReference Include="SDL3-CS.Windows.Shadercross" Version="3.0.0.15" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.20" />
    <PackageReference Include="SDL3-CS.Linux.Shadercross" Version="3.0.0.15" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX')))">
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.20" />
    <PackageReference Include="SDL3-CS.MacOS.Shadercross" Version="3.0.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Shaders\**\*.hlsl" CopyToOutputDirectory="PreserveNewest" LinkBase="Shaders" />
  </ItemGroup>
</Project>
